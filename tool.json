{
  "id": "health-scan",
  "version": "1.0.0",
  "name": "健康扫描",
  "description": "扫描静态资源 404、接口报错、CSS/布局异常；黑白名单规则见 config/",
  "icon": "tool",
  "category": "test",
  "rpc": {
    "protocolVersion": 2
  },
  "capabilities": [
    "project.context",
    "project.list",
    "project.variables",
    "config.settings",
    "config.browserRuntime",
    "fs.dataDir"
  ],
  "ports": {
    "preferredProd": 7203,
    "prod": 7203,
    "dev": 3203,
    "webDev": 5203
  },
  "main": "server/dist/index.js",
  "webRoot": "web/dist",
  "engines": {
    "host": ">=2.1.0"
  },
  "sandbox": {
    "allow": [
      "scripts",
      "forms",
      "popups",
      "same-origin"
    ],
    "bridge": []
  }
}

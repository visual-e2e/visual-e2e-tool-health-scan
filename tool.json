{
  "id": "health-scan",
  "version": "1.0.0",
  "name": "健康扫描",
  "description": "扫描静态资源 404、接口 5xx、页面错乱与失效点击",
  "icon": "tool",
  "category": "test",
  "rpc": {
    "protocolVersion": 1
  },
  "capabilities": [
    "project.context"
  ],
  "ports": {
    "preferredProd": 7203,
    "prod": 7203,
    "dev": 3203,
    "webDev": 5203
  },
  "main": "server/dist/index.js",
  "webRoot": "web/dist",
  "engines": {
    "host": ">=1.4.0"
  },
  "sandbox": {
    "allow": [
      "scripts",
      "forms",
      "popups",
      "same-origin"
    ],
    "bridge": []
  }
}

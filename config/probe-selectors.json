{
  "version": 2,
  "type": "probe",
  "rules": [
    {
      "id": 1,
      "title": "通用可点击元素",
      "category": "click",
      "action": "click",
      "type": "selector",
      "op": "equals",
      "values": [
        "button:not([disabled])",
        "[role='button']",
        "input[type='button']:not([disabled])",
        "input[type='submit']:not([disabled])",
        "input[type='reset']:not([disabled])"
      ],
      "description": "基础点击候选"
    },
    {
      "id": 3,
      "title": "导航候选",
      "category": "nav",
      "action": "click",
      "type": "selector",
      "op": "equals",
      "values": [
        "nav a[href]"
      ],
      "description": "仅保留导航锚点"
    },
    {
      "id": 2,
      "title": "Hover 候选",
      "category": "hover",
      "action": "hover",
      "type": "selector",
      "op": "equals",
      "values": [
        "[aria-haspopup='true']",
        "[aria-expanded='false']",
        "[class*='hover']",
        "[data-hover]",
        "[style*='hover']"
      ],
      "description": "候选 hover 元素，结合样式变化与 :hover 规则判定"
    }
  ]
}
